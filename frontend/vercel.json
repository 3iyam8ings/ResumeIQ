{
    "headers": [
        {
            "source": "/oauth2/authorization/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://resumeiq-4wpk.onrender.com/api/:path*"
        },
        {
            "source": "/oauth2/:path*",
            "destination": "https://resumeiq-4wpk.onrender.com/oauth2/:path*"
        },
        {
            "source": "/login/oauth2/:path*",
            "destination": "https://resumeiq-4wpk.onrender.com/login/oauth2/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}